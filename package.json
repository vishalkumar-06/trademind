{
  "name": "trademind-ai",
  "private": true,
  "version": "0.1.0",
  "description": "TradeMind AI — multi-agent trading copilot (Planner → Specialized Agents → MCP Tool Layer → Persistent Context Engine → Trader Dashboard)",
  "workspaces": [
    "packages/*",
    "services/*",
    "services/mcp-servers/*",
    "services/agents/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "migrate": "npm run migrate --workspace=@trademind/context-engine",
    "dev:risk-agent": "npm run dev --workspace=@trademind/risk-analysis-agent",
    "dev:reconciliation-agent": "npm run dev --workspace=@trademind/trade-reconciliation-agent",
    "dev:portfolio-agent": "npm run dev --workspace=@trademind/portfolio-agent",
    "dev:market-agent": "npm run dev --workspace=@trademind/market-intelligence-agent",
    "dev:compliance-agent": "npm run dev --workspace=@trademind/compliance-agent",
    "dev:communication-agent": "npm run dev --workspace=@trademind/communication-agent",
    "dev:challenger-agent": "npm run dev --workspace=@trademind/challenger-agent",
    "dev:confidence-gate": "npm run dev --workspace=@trademind/confidence-gate",
    "dev:ingress-bus": "npm run dev --workspace=@trademind/ingress-bus",
    "dev:planner": "npm run dev --workspace=@trademind/planner",
    "dev:dashboard-api": "npm run dev --workspace=@trademind/dashboard-api",
    "dev:dashboard-web": "npm run dev --workspace=@trademind/dashboard-web"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1"
  }
}
