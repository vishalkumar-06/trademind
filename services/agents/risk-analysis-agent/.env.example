# Risk Analysis Agent Configuration

# Anthropic API Key (required for Claude LLM)
ANTHROPIC_API_KEY=sk-your-api-key-here

# Risk Engine MCP Server URL (must be port 3102, this is enforced)
RISK_ENGINE_MCP_URL=http://localhost:3102

# Context Engine URL (where agent retrieves context and writes results)
CONTEXT_ENGINE_URL=http://localhost:3001

# Agent server port (3200 is default for Risk Analysis Agent)
PORT=3200

# Optional: Node environment
NODE_ENV=development
