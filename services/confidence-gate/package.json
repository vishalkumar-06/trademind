{
  "name": "@trademind/confidence-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Confidence Gate service — evaluates agent outputs against confidence thresholds and routes low-confidence results to Challenger Agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@trademind/shared-types": "*",
    "@trademind/agent-base": "*",
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
